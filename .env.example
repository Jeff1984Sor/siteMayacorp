# Porta interna do Next (confirmar que está livre no prod2 com `ss -tlnp`)
PORT=3010

# SMTP para o formulário de contato.
# Se SMTP_HOST/SMTP_USER/SMTP_PASS ficarem vazios, o formulário cai para mailto:.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente opcional (padrão: "MayaCorp <SMTP_USER>")
SMTP_FROM=

CONTACT_TO=mayacorp@mayacorp.com.br

# "true" envia uma confirmação automática para quem preencheu o formulário
CONTACT_AUTOREPLY=false
