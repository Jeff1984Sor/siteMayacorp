# Porta interna do Next (confirmar que está livre no prod2 com `ss -tlnp`)
PORT=3010

# SMTP para o formulário de contato.
# Se SMTP_HOST/SMTP_USER/SMTP_PASS ficarem vazios, o formulário cai para mailto:.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente opcional (padrão: "MayaCorp <SMTP_USER>")
SMTP_FROM=

CONTACT_TO=mayacorp@mayacorp.com.br

# "true" envia uma confirmação automática para quem preencheu o formulário
CONTACT_AUTOREPLY=false

# --- MayaJus: contratação online ---
# Senha do painel /admin/pedidos (mínimo de 8 caracteres). Vazio = painel desativado.
ADMIN_PASSWORD=

# Onde salvar os pedidos quando não há banco (padrão: ./data). A pasta fica fora do git.
PEDIDOS_DIR=

# PostgreSQL (opcional). Com isso preenchido, os pedidos vão para o banco em vez do arquivo.
# Ex.: postgres://mayacorp_site:SENHA@127.0.0.1:5432/mayacorp_site  (ver deploy/sql/mayajus-pedidos.sql)
DATABASE_URL=

# Provedor de pagamento. Hoje só "manual" (link enviado pela equipe depois do contato).
PAYMENT_PROVIDER=manual
